# Longbridge OAuth Client ID (required)
CLIENT_ID=your-client-id-here

# Path to the stock_analysis.db file (required)
DB_PATH=./data/stock_analysis.db

# Price threshold percentage: skip signals where current price exceeds
# target price by more than this percentage (default: 2)
# PRICE_THRESHOLD_PCT=2

# Buy position size as percentage of account net assets (default: 15)
BUY_PCT=15

# Sell ratio for reduce (减仓) mode as percentage of available quantity (default: 50)
SELL_PCT=50

# Time window in hours for fetching analysis records (default: 4)
WINDOW_HOURS=4
