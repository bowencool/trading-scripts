# Longbridge OAuth Client ID (required)
CLIENT_ID=your-client-id-here

# Path to the stock_analysis.db file for local runs (required)
# Docker image uses a fixed internal path: /app/db/stock_analysis.db
DB_PATH=./data/stock_analysis.db

# Price threshold percentage: skip signals where current price exceeds
# target price by more than this percentage (default: 2)
# PRICE_THRESHOLD_PCT=2

# Buy position size as percentage of account buying power (default: 15)
BUY_PCT=15

# Risk budget per buy as percentage of account net assets (default: 1).
# Set to 0 to fall back to BUY_PCT-only sizing.
RISK_PCT_PER_TRADE=1

# Max single-symbol exposure as percentage of account net assets (default: 20).
# Set to 0 to disable.
MAX_POSITION_PCT=20

# Max number of held symbols. Pending buy orders count as occupied slots.
# Set to 0 to disable.
MAX_HOLDINGS=0

# Treat any held symbol without visible SL/TP as needing recovery, including
# cross-day positions. Default false keeps the legacy conservative behavior.
STRICT_SLTP_CHECK=false

# Sell ratio for reduce (减仓) mode as percentage of available quantity (default: 50)
SELL_PCT=50

# Time window in hours for fetching analysis records (default: 4)
WINDOW_HOURS=4
