# Longbridge OAuth 客户端 ID (必填)
CLIENT_ID=your-client-id-here

# 本地运行时 stock_analysis.db 文件的路径 (必填)
# Docker 镜像使用固定的内部路径: /app/db/stock_analysis.db
DB_PATH=./data/stock_analysis.db

# 价格阈值百分比: 当前价格超过目标价格超过此百分比时跳过信号 (默认: 2)
# PRICE_THRESHOLD_PCT=2

# 买入仓位大小，占可用购买力的百分比 (默认: 15)
BUY_PCT=15

# 单笔交易的风险预算，占账户净资产的百分比 (默认: 1)
# 设为 0 时只按 BUY_PCT 限制
RISK_PCT_PER_TRADE=1

# 单只标的最大敞口，占账户净资产的百分比 (默认: 20)
# 设为 0 禁用此限制
MAX_POSITION_PCT=20

# 最多持仓标的数。待成交的买单也算作占用的槽位。
# 设为 0 禁用此限制
MAX_HOLDINGS=0

# 对于没有可见 SL/TP 的持仓进行恢复处理，包括跨日持仓
# 默认为 false 保持原保守行为
STRICT_SLTP_CHECK=false

# 减仓模式下的卖出比例，占可用数量的百分比 (默认: 50)
SELL_PCT=50

# 获取分析记录的时间窗口 (小时) (默认: 4)
WINDOW_HOURS=4
